<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="22dp"
    android:paddingEnd="32dp"
    android:paddingBottom="12dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0.5"
        android:contentDescription="@string/empty_title"
        android:src="@drawable/ic_car" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/empty_title"
        android:textAppearance="@style/Text.Tesla.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/empty_body"
        android:textAppearance="@style/Text.Tesla.Caption"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="6dp"
        android:text="@string/empty_step1"
        android:textAppearance="@style/Text.Tesla.Caption"
        android:textColor="@color/on_surface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="6dp"
        android:text="@string/empty_step2"
        android:textAppearance="@style/Text.Tesla.Caption"
        android:textColor="@color/on_surface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="6dp"
        android:text="@string/empty_step3"
        android:textAppearance="@style/Text.Tesla.Caption"
        android:textColor="@color/on_surface" />
</LinearLayout>
